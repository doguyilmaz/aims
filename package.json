{
  "name": "ai-multi-session",
  "version": "0.1.0",
  "description": "Run several Claude Code and Codex accounts (personal, work, ...) side by side: one-time login per account, instant switching, shared history, automatic failover. Ships a CLI, an MCP server and a skill.",
  "type": "module",
  "bin": {
    "aims": "src/cli.ts"
  },
  "files": [
    "src",
    "skills",
    ".claude-plugin",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p .",
    "check": "tsc -p . && bun test",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/aims"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "multi-account",
    "profiles",
    "mcp",
    "bun"
  ],
  "license": "MIT"
}
