# Setup: personal (existing login), work and client, all logged in, in this
# order, with the account that takes over staying active.
exec claude auth login --email me@gmail.com
exec aims init --yes --tools claude --integrations none
exec aims login claude work
exec aims login claude client
exec aims order claude personal work client --after-reset stay
stderr 'once personal works again: stay on the one that took over'

# A pick that passed over an account resting from a 429 only stands in: that
# account is back in minutes.
cp LIMITED $HOME/.aims/profiles/claude/work/BUSY
! exec aims claude@work -p --output-format stream-json -- busy
cp LIMITED $HOME/.claude/LIMITED
! exec aims claude@personal -p -- limited
exec aims claude -p -- passes-over
stdout 'answer from client: passes-over'
! stderr 'is the active account now'
exec aims status claude
stdout '● personal'

# Once the 429 is over, the next account in order takes the place.
exec aims clear claude work
rm $HOME/.aims/profiles/claude/work/BUSY
exec aims claude -p -- takes-over
stdout 'answer from work: takes-over'
stderr '"work" is the active account now and stays so after "personal" works again'
exec aims status claude
stdout '● work'

# A headless run repeated on the next account hands the place over too, and
# says so after the retry.
exec aims clear claude
exec aims use personal
exec aims claude -p --output-format stream-json -- retried
stdout 'answer from work: retried'
stderr 'retrying with "work"[\s\S]*"work" is the active account now'

# aims failover in a pinned terminal hands the place to the next account in
# order, not to the pin, and the pinned terminal keeps its account.
exec aims clear claude
rm $HOME/.claude/LIMITED
exec aims use personal
env AIMS_CLAUDE_PROFILE=client
exec aims failover claude --from personal --minutes 30
stderr 'Claude Code now uses work; personal rests'
stderr 'this terminal is pinned to client and keeps using it'
env AIMS_CLAUDE_PROFILE=
exec aims status claude
stdout '● work'

-- LIMITED --
