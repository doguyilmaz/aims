# Setup: personal (existing login) and work, both logged in.
exec claude auth login --email me@gmail.com
exec aims init --yes --tools claude --integrations none
exec aims login claude work

# personal is out of quota. A headless run that failed before calling any
# tool is repeated on work, and only work's answer is printed.
cp LIMITED $HOME/.claude/LIMITED
exec aims claude -p --output-format stream-json -- hello
stdout '"result":"answer from work: hello"'
! stdout 'hit your session limit'
stderr 'claude/personal hit its usage limit before doing anything, retrying with "work"'
exec aims status claude
# The mark lasts until the reset the message names (5pm), and says who set it.
stdout 'personal .*limited [0-9hm]+ .*marked by a failed run'

# The next run goes to work straight away.
exec aims claude -p -- again
stdout 'answer from work: again'
stderr 'skipping "personal" \(limit for [0-9hm]+, marked by a failed run\), using "work"'
stderr 'personal works again\? aims clear claude personal'

# A run that already called a tool is not repeated, even with a profile to spare.
exec aims clear claude personal
rm $HOME/.claude/LIMITED
cp LIMITED $HOME/.aims/profiles/claude/work/LIMITED
cp LIMITED $HOME/.aims/profiles/claude/work/TOOL_FIRST
exec aims use work
! exec aims claude -p --output-format stream-json -- touch-things
stdout 'hit your session limit'
stderr 'not retried: the run may already have changed things'
grep -count=1 'tool ran as work' $WORK/side-effects

# Text output hides tool calls: a limit there is not retried either...
exec aims clear claude
rm $HOME/.aims/profiles/claude/work/TOOL_FIRST
exec aims use work
! exec aims claude -p -- text-mode
stdout 'hit your session limit'
stderr 'not retried'

# Nor is a login error: plain output cannot show that no tool ran. The
# account is marked, and the next run goes elsewhere.
exec aims clear claude
rm $HOME/.aims/profiles/claude/work/LIMITED
cp LIMITED $HOME/.aims/profiles/claude/work/EXPIRED
! exec aims claude -p -- text-login
stdout 'Please run /login'
stderr 'claude/work hit a login error; new runs will use another profile \(not retried'
exec aims status claude
stdout 'work .*login expired'
stdout '→ aims login claude work'
exec aims claude -p -- next-run
stdout 'answer from default: next-run'
stderr 'log work in again: aims login claude work'

# A run that succeeds clears the account's old marks.
rm $HOME/.aims/profiles/claude/work/EXPIRED
exec aims claude@work -p -- works-again
stdout 'answer from work: works-again'
exec aims status claude
stdout 'work .*ready'

# A 429 is a short rate limit, not the plan's: retried elsewhere, and the
# account rests for two minutes, not hours.
exec aims clear claude
exec aims use personal
cp LIMITED $HOME/.claude/BUSY
exec aims claude -p --output-format stream-json -- busy
stdout 'answer from work: busy'
stderr 'claude/personal hit a rate limit before doing anything, retrying with "work"'
exec aims status claude
stdout 'personal .*busy [12]m'
rm $HOME/.claude/BUSY

# A pinned profile turns automatic failover off.
exec aims clear claude
cp LIMITED $HOME/.aims/profiles/claude/work/EXPIRED
! exec aims claude@work -p -- pinned
stdout 'Please run /login'
! stderr 'retrying'

# aims failover marks a profile by hand. New sessions skip it while the mark
# lasts and come back to the active profile on their own.
exec aims clear claude
rm $HOME/.aims/profiles/claude/work/EXPIRED
exec aims use personal
# It marks the profile used last (work, by the pinned run above).
exec aims failover claude --minutes 30
stderr 'work rests \(30m, until \d\d:\d\d\); new Claude Code sessions use personal until then'
stderr 'work was marked because it was used last'
exec aims clear claude work
exec aims failover claude --from personal --minutes 90
stderr 'personal rests \(1h30m, until \d\d:\d\d\); new Claude Code sessions use work until then'
exec aims status claude
stdout '● personal .*limited 1h30m'
stdout 'work .*ready .*standing in for personal'
exec aims claude
stdout 'claude interactive as work'
stderr 'skipping "personal" \(limit for 1h30m, marked by aims failover\), using "work"'
exec aims clear claude personal
exec aims claude
stdout 'claude interactive as default'
exec aims status claude
! stdout 'standing in'

# --to makes another profile active instead.
exec aims failover claude --from personal --to work --minutes 90
stderr 'Claude Code now uses work; personal rests \(1h30m'
exec aims status claude
stdout '● work .*ready'
stdout 'personal .*limited 1h30m'
! exec aims failover claude --from work
stderr 'no other usable'
! exec aims failover claude --from work --to work
stderr 'work is the profile being marked'
exec aims clear claude
exec aims failover claude --from work --to personal --reason login
stderr 'Claude Code now uses personal; work is marked as logged out'
stderr 'aims login claude work'
exec aims status claude
stdout 'work .*login expired'
exec aims login claude work
exec aims status claude
stdout 'work .*ready'
! exec aims failover claude --reason tired
stderr 'reason must be limit or login'
exec aims clear claude personal
exec aims status claude
stdout 'personal .*ready'

-- LIMITED --
